{
  auto_https off
}

:3456 {
  # No basic auth here - auth is handled by the frontend application
  # WebSocket proxy to OpenClaw gateway
  @websocket {
    header Connection *Upgrade*
    header Upgrade websocket
  }
  reverse_proxy @websocket localhost:18789 {
    header_up Host {host}
    header_up Connection Upgrade
    header_up Upgrade websocket
  }

  # Fallback
  respond "ToClaw WebChat Gateway" 200

  log {
    output file /home/openclaw/openclaw-webchat/caddy.log
  }
}
